          <EntitySet Name="VWListarTiposDocumentoSerieDepto" EntityType="Self.VWListarTiposDocumentoSerieDepto" store:Type="Views" store:Schema="Archivistica">
            <DefiningQuery>SELECT 
    [VWListarTiposDocumentoSerieDepto].[Nombre] AS [Nombre], 
    [VWListarTiposDocumentoSerieDepto].[Id] AS [Id], 
    [VWListarTiposDocumentoSerieDepto].[TradicionDocumental] AS [TradicionDocumental], 
    [VWListarTiposDocumentoSerieDepto].[IdSoporteFisico] AS [IdSoporteFisico], 
    [VWListarTiposDocumentoSerieDepto].[IdSoporteElectronico] AS [IdSoporteElectronico], 
    [VWListarTiposDocumentoSerieDepto].[IdSoporteDigital] AS [IdSoporteDigital], 
    [VWListarTiposDocumentoSerieDepto].[TipoConfidencialidad] AS [TipoConfidencialidad], 
    [VWListarTiposDocumentoSerieDepto].[Integridad] AS [Integridad], 
    [VWListarTiposDocumentoSerieDepto].[Disponibilidad] AS [Disponibilidad], 
    [VWListarTiposDocumentoSerieDepto].[IdSerie] AS [IdSerie], 
    [VWListarTiposDocumentoSerieDepto].[IdDepto] AS [IdDepto], 
    [VWListarTiposDocumentoSerieDepto].[IdVersionTRD] AS [IdVersionTRD]
    FROM [Archivistica].[VWListarTiposDocumentoSerieDepto] AS [VWListarTiposDocumentoSerieDepto]</DefiningQuery>
